{
  "name": "playwright-framework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "report": "playwright show-report",
    "clean:allure": "rimraf allure-results allure-report",
    "test:allure": "npm run clean:allure && playwright test",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "type-check": "tsc --noEmit",
    "smoke": "npm run clean:allure && playwright test -g \"@smoke\"",
    "smoke:ui": "npm run clean:allure && playwright test Tests/ui -g \"@smoke\"",
    "smoke:api": "npm run clean:allure && playwright test Tests/api -g \"@smoke\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.2.3",
    "allure-commandline": "^2.38.1",
    "allure-playwright": "^3.7.0",
    "rimraf": "^6.1.3"
  },
  "dependencies": {
    "dotenv": "^17.3.1"
  }
}
